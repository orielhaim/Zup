{
  "$id": "https://zup.dev/schema/zup.toml.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "zup installer manifest",
  "description": "Declarative application installer manifest for zup.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "const": 1
    },
    "app": {
      "$ref": "#/$defs/App"
    },
    "frontend": {
      "$ref": "#/$defs/Frontend",
      "default": "gui"
    },
    "ui": {
      "anyOf": [
        {
          "$ref": "#/$defs/UiBranding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "build": {
      "$ref": "#/$defs/Build"
    },
    "install": {
      "$ref": "#/$defs/Install"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Targeted"
      },
      "default": []
    },
    "updates": {
      "anyOf": [
        {
          "$ref": "#/$defs/Updates"
        },
        {
          "type": "null"
        }
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Targeted2"
      },
      "default": []
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Targeted3"
      },
      "default": []
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Targeted4"
      },
      "default": []
    },
    "launchers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Targeted5"
      },
      "default": []
    },
    "path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Targeted6"
      },
      "default": []
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Targeted7"
      },
      "default": []
    },
    "protocols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Targeted8"
      },
      "default": []
    },
    "file_associations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Targeted9"
      },
      "default": []
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "app",
    "build",
    "install"
  ],
  "examples": [
    {
      "schema": 1,
      "app": {
        "id": "com.example.acme",
        "name": "Acme",
        "version": "1.0.0"
      },
      "build": {
        "targets": {
          "windows-x64": {
            "target": "x86_64-pc-windows-msvc",
            "source": {
              "directory": "dist/windows-x64"
            },
            "frontend": "console",
            "install": {
              "scope": "user",
              "directory": {
                "user": "${location.user_data}/Acme"
              }
            }
          }
        }
      },
      "install": {
        "scope": "either",
        "allow_directory_override": true,
        "directory": {
          "user": "${location.user_data}/Acme",
          "machine": "${location.programs}/Acme"
        }
      }
    }
  ],
  "$defs": {
    "App": {
      "description": "Application identity and display metadata.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/AppId"
        },
        "name": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "version": {
          "type": "string"
        },
        "publisher": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyString"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "main": {
          "anyOf": [
            {
              "$ref": "#/$defs/Template"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version"
      ]
    },
    "AppId": {
      "description": "Stable logical application identifier.",
      "type": "string"
    },
    "NonEmptyString": {
      "description": "Non-empty display name or label.",
      "type": "string"
    },
    "Template": {
      "description": "A path or command template using zup variables such as ${install} and ${location.user_data}.",
      "type": "string",
      "examples": [
        "${install}/app.exe",
        "${location.programs}/Acme"
      ]
    },
    "Frontend": {
      "type": "string",
      "enum": [
        "gui",
        "console",
        "headless"
      ]
    },
    "UiBranding": {
      "type": "object",
      "properties": {
        "logo": {
          "anyOf": [
            {
              "$ref": "#/$defs/Template"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "accent": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "theme": {
          "$ref": "#/$defs/UiTheme",
          "default": "system"
        },
        "license_link": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "legal_text": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "UiTheme": {
      "type": "string",
      "enum": [
        "system",
        "light",
        "dark"
      ]
    },
    "Build": {
      "description": "Build configuration and target matrix.",
      "type": "object",
      "properties": {
        "targets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/TargetProfile"
          },
          "minProperties": 1
        },
        "artifacts": {
          "description": "Distribution artifacts this project publishes.\n\nDeclaring artifacts is optional. A project that declares none builds one\ninstaller per selected target, which is the simplest thing that works.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ArtifactProfile"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "targets"
      ]
    },
    "TargetProfile": {
      "description": "Build payload declared for one target profile.",
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "frontend": {
          "anyOf": [
            {
              "$ref": "#/$defs/Frontend"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "install": {
          "anyOf": [
            {
              "$ref": "#/$defs/Install"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "target",
        "source"
      ]
    },
    "Source": {
      "description": "Payload source for the installer (build-time, not install-time).",
      "type": "object",
      "properties": {
        "directory": {
          "type": "string"
        }
      },
      "required": [
        "directory"
      ]
    },
    "Install": {
      "description": "Installation scope and destination templates.",
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/InstallScope"
        },
        "directory": {
          "$ref": "#/$defs/InstallDirectory",
          "default": {
            "user": null,
            "machine": null
          }
        },
        "allow_directory_override": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "scope"
      ]
    },
    "InstallScope": {
      "description": "Scope an installer may target.",
      "type": "string",
      "enum": [
        "user",
        "machine",
        "either"
      ]
    },
    "InstallDirectory": {
      "description": "Unresolved install-root templates by scope.",
      "type": "object",
      "properties": {
        "user": {
          "anyOf": [
            {
              "$ref": "#/$defs/Template"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "machine": {
          "anyOf": [
            {
              "$ref": "#/$defs/Template"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "ArtifactProfile": {
      "description": "One declared distribution artifact.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ArtifactKind",
          "default": "universal"
        },
        "mode": {
          "$ref": "#/$defs/ArtifactMode",
          "default": "offline"
        },
        "targets": {
          "description": "The target profiles this artifact includes. Required.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetProfileId"
          }
        },
        "channel": {
          "description": "The release channel this artifact follows.\n\nAn artifact without a channel is labelled with an exact version and always\ninstalls it. An artifact with one installs the channel's current release,\nwhich is a different promise and a different file name.",
          "type": [
            "string",
            "null"
          ]
        },
        "output": {
          "description": "The output file name. Derived from the application name when absent.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "targets"
      ]
    },
    "ArtifactKind": {
      "description": "How much of a target set one artifact file carries.",
      "oneOf": [
        {
          "description": "One file carrying every included target, selected at run time.",
          "type": "string",
          "const": "universal"
        },
        {
          "description": "One file carrying exactly one target.",
          "type": "string",
          "const": "single"
        }
      ]
    },
    "ArtifactMode": {
      "description": "Whether an artifact carries its content or fetches it.",
      "oneOf": [
        {
          "description": "Every required byte is inside the artifact. No network is used.",
          "type": "string",
          "const": "offline"
        },
        {
          "description": "The artifact carries what it needs to start and select a variant; the rest\nis fetched by digest through the update trust configuration.",
          "type": "string",
          "const": "thin"
        }
      ]
    },
    "TargetProfileId": {
      "description": "Stable, human-readable identity for a target profile.",
      "type": "string"
    },
    "Targeted": {
      "description": "A resource declaration with optional target-profile applicability.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "component": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target": {
          "$ref": "#/$defs/PrerequisiteArchitecture",
          "default": "current"
        },
        "requirement": {
          "$ref": "#/$defs/PrerequisiteRequirement"
        },
        "package": {
          "$ref": "#/$defs/PrerequisitePackage"
        },
        "installer": {
          "$ref": "#/$defs/PrerequisiteInstaller",
          "default": {
            "arguments": [],
            "success_exit_codes": [
              0
            ],
            "reboot_exit_codes": [
              1641,
              3010
            ],
            "privilege": "system"
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetProfileId"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "requirement",
        "package"
      ]
    },
    "ComponentId": {
      "description": "Stable logical component identifier.",
      "type": "string"
    },
    "Condition": {
      "description": "A component expression such as component(\"docs\") or !component(\"debug\").",
      "type": "string",
      "examples": [
        "component(\"docs\")",
        "!component(\"debug\")"
      ]
    },
    "PrerequisiteArchitecture": {
      "type": "string",
      "enum": [
        "x86",
        "x64",
        "arm64",
        "current",
        "any"
      ]
    },
    "PrerequisiteRequirement": {
      "description": "The portable semantic condition a prerequisite must satisfy.\n\nEvery variant names a fact the target system can be asked about. Detection\nmechanics, package formats, and registry layout belong to the platform\nprovider, not to this model.",
      "oneOf": [
        {
          "description": "A runtime that must be present, optionally within a version range.",
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/RuntimeRequirementId"
            },
            "version": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "kind": {
              "type": "string",
              "const": "runtime"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "description": "An installed package that must be present, optionally within a version range.",
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/InstalledPackageId"
            },
            "version": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "kind": {
              "type": "string",
              "const": "installed_package"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "description": "A file that must exist, optionally with a matching file version.",
          "type": "object",
          "properties": {
            "path": {
              "$ref": "#/$defs/Template"
            },
            "version": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "kind": {
              "type": "string",
              "const": "file_version"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ]
        }
      ]
    },
    "RuntimeRequirementId": {
      "description": "Opaque identifier of a runtime a platform provider knows how to observe.\n\nThe identifier is a namespaced, lowercase dotted path such as\n`provider.toolchain.v14`. Portable crates validate its shape but never\ninterpret it; the platform backend owns the meaning of each id it\npublishes, and only the backend may attach a meaning to a segment.",
      "type": "string"
    },
    "InstalledPackageId": {
      "description": "Opaque identifier of an installed package, such as a product code.\n\nPortable crates validate the shape only; the platform backend decides which\nidentifiers it can answer and what they mean.",
      "type": "string"
    },
    "PrerequisitePackage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "size": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "embedded"
            }
          },
          "required": [
            "type",
            "path",
            "sha256",
            "size"
          ]
        },
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "size": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0,
              "default": null
            },
            "filename": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "remote"
            }
          },
          "required": [
            "type",
            "url",
            "sha256",
            "filename"
          ]
        }
      ]
    },
    "PrerequisiteInstaller": {
      "description": "How a prerequisite package is run once its requirement is unsatisfied.\n\nThe provider owns the command line it builds; the manifest only supplies\nextra arguments, the accepted exit codes, and the privilege it needs.",
      "type": "object",
      "properties": {
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "success_exit_codes": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          },
          "default": [
            0
          ]
        },
        "reboot_exit_codes": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          },
          "default": [
            1641,
            3010
          ]
        },
        "privilege": {
          "$ref": "#/$defs/Privilege",
          "default": "system"
        }
      },
      "additionalProperties": false
    },
    "Privilege": {
      "description": "Authorization an operation needs on the target host.\n\nThis names *who* must perform an operation, never *how* the host obtains\nthat authority. Elevation, impersonation, and policy prompts are platform\nconcerns resolved by a platform runtime, not by this value.",
      "oneOf": [
        {
          "description": "The signed-in user is enough.",
          "type": "string",
          "const": "user"
        },
        {
          "description": "Host-wide authority is required.",
          "type": "string",
          "const": "system"
        }
      ]
    },
    "Updates": {
      "description": "Build-time update repository settings.",
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "root": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "repository",
        "channel",
        "root"
      ]
    },
    "Targeted2": {
      "description": "A resource declaration with optional target-profile applicability.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "name": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "default": {
          "type": "boolean",
          "default": true
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentId"
          },
          "default": []
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetProfileId"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "Targeted3": {
      "description": "A resource declaration with optional target-profile applicability.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "component": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetProfileId"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "source"
      ]
    },
    "Targeted4": {
      "description": "A resource declaration with optional target-profile applicability.",
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "destination": {
          "$ref": "#/$defs/Template"
        },
        "component": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "allow_empty": {
          "description": "Allow a pattern that matches zero files. Default: reject.",
          "type": "boolean",
          "default": false
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetProfileId"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "destination"
      ]
    },
    "Targeted5": {
      "description": "A resource declaration with optional target-profile applicability.",
      "type": "object",
      "properties": {
        "location": {
          "$ref": "#/$defs/LauncherLocation"
        },
        "name": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "target": {
          "$ref": "#/$defs/Template"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "working_directory": {
          "anyOf": [
            {
              "$ref": "#/$defs/Template"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "component": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetProfileId"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "location",
        "name",
        "target"
      ]
    },
    "LauncherLocation": {
      "description": "Portable application launcher location.",
      "type": "string",
      "enum": [
        "menu",
        "desktop"
      ]
    },
    "Targeted6": {
      "description": "A resource declaration with optional target-profile applicability.",
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/Template"
        },
        "component": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "targets": {
          "type": "array",
          "items": {
