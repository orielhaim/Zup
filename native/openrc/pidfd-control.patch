+static bool release_worker(void)
+{
+	struct pollfd event = { .fd = worker_exec, .events = POLLIN };
+	char value;
+	bool ready = false;
+	int result;
+	int64_t deadline = worker_start_deadline, remaining;
+
+	if (worker_gate < 0)
+		return true;
+	if (rc_stop_now() < deadline && write(worker_gate, "1", 1) == 1) {
+		do {
+			remaining = deadline - rc_stop_now();
+			if (remaining <= 0) { result = 0; break; }
+			result = poll(&event, 1, (int)remaining);
+		} while (result < 0 && errno == EINTR);
+		ready = result > 0 && read(worker_exec, &value, 1) == 0 &&
+		    rc_pidfd_alive(child_pidfd) == 1 && rc_stop_now() < deadline;
+		if (ready && !publish_child("running"))
+			ready = false;
+	}
+	close(worker_gate);
+	close(worker_exec);
+	worker_gate = worker_exec = -1;
+	if (!ready) {
+		no_respawn = true;
+		exiting = 1;
+	}
+	return ready;
+}
