+static int retain_controller(pid_t *pid)
+{
+	char record[160], executable[64], extra;
+	struct stat identity, own_image, image;
+	long number;
+	uint64_t ticks;
+	int fd, handle;
+	ssize_t size;
+
+	fd = open(identitypath, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+	if (fd < 0)
+		return -1;
+	if (fstat(fd, &identity) < 0 || !S_ISREG(identity.st_mode) ||
+	    identity.st_uid != geteuid() || (identity.st_mode & 077) != 0) {
+		close(fd); errno = EPERM; return -1;
+	}
+	size = read(fd, record, sizeof(record) - 1);
+	close(fd);
+	if (size <= 0 || size == sizeof(record) - 1)
+		return -1;
+	record[size] = 0;
+	if (sscanf(record, "%32s %ld %"SCNu64" %c", controller_instance,
+	    &number, &ticks, &extra) != 3 || number <= 0 || number > INT_MAX ||
+	    strlen(controller_instance) != 32 ||
+	    strspn(controller_instance, "0123456789abcdef") != 32)
+		return -1;
+	*pid = (pid_t)number;
+	handle = rc_pidfd_open(*pid);
+	if (handle < 0)
+		return -1;
+	snprintf(executable, sizeof(executable), "/proc/%ld/exe", number);
+	if (process_start_ticks(*pid) != ticks ||
+	    stat("/proc/self/exe", &own_image) < 0 || stat(executable, &image) < 0 ||
+	    own_image.st_dev != image.st_dev || own_image.st_ino != image.st_ino ||
+	    process_start_ticks(*pid) != ticks || rc_pidfd_alive(handle) != 1) {
+		close(handle); errno = ESTALE; return -1;
+	}
+	return handle;
+}
