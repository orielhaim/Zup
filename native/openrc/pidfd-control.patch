+static void stop_result(bool success)
+{
+	char result[96];
+	if (!stop_request[0])
+		return;
+	snprintf(result, sizeof(result), "%s %ld %s", stop_request,
+	    (long)getpid(), success ? "stopped" : "pending");
+	if (!publish_state(resultpath, result))
+		syslog(LOG_ERR, "Unable to publish shutdown result: %s", strerror(errno));
+}
+
+static void strict_control(int timeout)
+{
+	struct pollfd events[2] = {
+		{ .fd = fifo_fd, .events = POLLIN },
+		{ .fd = child_pidfd, .events = POLLIN }
+	};
+	char input[2048];
+	ssize_t count, at;
+	int sig, ready;
+	char instance[33], request[33], extra;
+	long expected_pid;
+	uint64_t expected_ticks, expected_generation;
+
+	ready = poll(events, 2, timeout);
+	if (ready < 0) {
+		if (errno != EINTR)
+			eerrorx("Unable to poll supervisor control: %s", strerror(errno));
+		return;
+	}
+	if (events[0].revents & (POLLERR | POLLHUP | POLLNVAL))
+		eerrorx("Supervisor control FIFO became unavailable");
+	if (!(events[0].revents & POLLIN))
+		return;
+	count = read(fifo_fd, input, sizeof(input));
+	if (count < 0) {
+		if (errno != EINTR && errno != EAGAIN)
+			eerrorx("Unable to read supervisor control: %s", strerror(errno));
+		return;
+	}
+	for (at = 0; at < count; ++at) {
+		if (input[at] == '\n') {
+			control_frame[control_length] = 0;
+			if (sscanf(control_frame, "stop %32s %32s %ld %"SCNu64" %"SCNu64" %c", instance, request, &expected_pid, &expected_ticks, &expected_generation, &extra) == 5 &&
+			    !strcmp(instance, controller_instance) && strlen(request) == 32 &&
+			    strspn(request, "0123456789abcdef") == 32 &&
+			    (expected_pid == 0 || (expected_pid == child_pid && expected_ticks > 0 &&
+			    child_start_ticks == expected_ticks && expected_generation == child_generation_counter && rc_pidfd_alive(child_pidfd) == 1) ||
+			    (child_pid == 0 && child_pidfd == -1 && expected_pid == reaped_child_pid &&
+			    expected_ticks == reaped_child_ticks && expected_generation == reaped_child_sequence &&
+			    expected_generation == child_generation_counter))) {
+				memcpy(stop_request, request, 33);
+				exiting = 1;
+				no_respawn = true;
+			} else if (!exiting && child_pidfd >= 0 &&
+			    sscanf(control_frame, "sig %d", &sig) == 1 &&
+			    sig >= 0 && sig < NSIG) {
+				if (rc_pidfd_signal(child_pidfd, sig) < 0 && errno != ESRCH)
+					syslog(LOG_ERR, "Unable to signal owned child: %s", strerror(errno));
+			}
+			control_length = 0;
+		} else if (control_length < sizeof(control_frame) - 1) {
+			control_frame[control_length++] = input[at];
+		}
+	}
+}
