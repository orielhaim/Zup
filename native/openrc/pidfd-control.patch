+static bool publish_controller(void)
+{
+	char record[160];
+	uint64_t ticks = process_start_ticks(getpid());
+
+	if (!ticks || !controller_instance[0])
+		return false;
+	snprintf(record, sizeof(record), "%s %ld %"PRIu64"\n",
+	    controller_instance, (long)getpid(), ticks);
+	return publish_state(identitypath, record);
+}
+
+static bool publish_child(const char *state)
+{
+	char record[192];
+	pid_t pid = child_pid ? child_pid : reaped_child_pid;
+	uint64_t ticks = child_pid ? child_start_ticks : reaped_child_ticks;
+
+	snprintf(record, sizeof(record), "%s %ld %"PRIu64" %"PRIu64" %s\n",
+	    controller_instance, (long)pid, ticks, child_generation_counter, state);
+	return publish_state(childpath, record);
+}
