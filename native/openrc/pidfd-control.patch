+static int stop_matching(const char *applet, const void *opaque, int sig,
+    bool test, bool quiet)
+{
+	const struct matching_target *target = opaque;
+	return do_stop(applet, target->exec, target->argv, target->pid,
+	    target->uid, sig, test, quiet);
+}
+
+int rc_pidfd_open(pid_t pid)
+{
+#if defined(__linux__) && defined(SYS_pidfd_open)
+	return syscall(SYS_pidfd_open, pid, 0);
+#else
+	(void)pid;
+	errno = ENOTSUP;
+	return -1;
+#endif
+}
+
+int rc_pidfd_signal(int fd, int sig)
+{
+#if defined(__linux__) && defined(SYS_pidfd_send_signal)
+	return syscall(SYS_pidfd_send_signal, fd, sig, NULL, 0);
+#else
+	(void)fd;
+	(void)sig;
+	errno = ENOTSUP;
+	return -1;
+#endif
+}
+
+int rc_pidfd_alive(int fd)
+{
+	struct pollfd event = { .fd = fd, .events = POLLIN };
+	int ready;
+
+	if (fd < 0) { errno = EBADF; return -1; }
+
+	do {
+		ready = poll(&event, 1, 0);
+	} while (ready < 0 && errno == EINTR);
+	if (ready < 0 || (event.revents & (POLLERR | POLLNVAL)))
+		return -1;
+	return (event.revents & (POLLIN | POLLHUP)) ? 0 : 1;
+}
+
+static int stop_pidfd(const char *applet, const void *opaque, int sig,
+    bool test, bool quiet)
+{
+	const int fd = *(const int *)opaque;
+	int alive = rc_pidfd_alive(fd);
+
+	(void)applet;
+	(void)quiet;
+	if (alive <= 0 || !sig || test)
+		return alive;
+	if (rc_pidfd_signal(fd, sig) == 0)
+		return 1;
+	return errno == ESRCH ? 0 : -1;
+}
+
+int run_stop_schedule(const char *applet,
+    const char *exec, const char *const *argv, pid_t pid, uid_t uid,
+    bool test, bool progress, bool quiet)
+{
+	const struct matching_target target = { exec, argv, pid, uid };
+	const char *const *p;
+	if (!(pid > 0 || exec || uid || (argv && *argv)))
+		return 0;
+
+	if (exec) {
+		einfov("Will stop %s", exec);
+		syslog(LOG_DEBUG, "Will stop %s", exec);
+	}
+	if (pid > 0) {
+		einfov("Will stop PID %d", pid);
+		syslog(LOG_DEBUG, "Will stop PID %d", pid);
+	}
+	if (uid) {
+		einfov("Will stop processes owned by UID %d", uid);
+		syslog(LOG_DEBUG, "Will stop processes owned by UID %d", uid);
+	}
+	if (argv && *argv) {
+		einfovn("Will stop processes of `");
+		if (rc_yesno(getenv("EINFO_VERBOSE"))) {
+			for (p = argv; p && *p; p++) {
+				if (p != argv)
+					printf(" ");
+				printf("%s", *p);
+			}
+			printf("'\n");
+		}
+	}
+
+	return run_schedule(applet, stop_matching, &target, test, progress, quiet);
+}
+
+int run_stop_schedule_pidfd(const char *applet, int pidfd,
+    bool test, bool progress, bool quiet)
+{
+	if (pidfd < 0) {
+		errno = EBADF;
+		return -1;
+	}
+	return run_schedule(applet, stop_pidfd, &pidfd, test, progress, quiet);
+}
