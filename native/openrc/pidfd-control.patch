+
+	if (!strict_pidfd)
+		return fork();
+	if (pipe2(gate, O_CLOEXEC) < 0)
+		return -1;
+	if (pipe2(exec_pipe, O_CLOEXEC) < 0) {
+		close(gate[0]); close(gate[1]);
+		return -1;
+	}
+	sigemptyset(&blocked);
+	sigaddset(&blocked, SIGCHLD);
+	if (sigprocmask(SIG_BLOCK, &blocked, &previous) < 0)
+		eerrorx("Unable to block child reaping: %s", strerror(errno));
+	pid = fork();
+	if (pid > 0) {
+		close(gate[0]); close(exec_pipe[1]);
+		child_pid = pid;
+		child_pidfd = rc_pidfd_open(pid);
+		child_start_ticks = process_start_ticks(pid);
+		if (child_pidfd >= 0 && !child_start_ticks) {
+			close(child_pidfd); child_pidfd = -1; errno = ESTALE;
+		}
+		if (child_pidfd >= 0) {
+			if (child_generation_counter == UINT64_MAX) {
+				close(child_pidfd); child_pidfd = -1; errno = EOVERFLOW;
+			} else {
+				snprintf(counter, sizeof(counter), "%"PRIu64, ++child_generation_counter);
+				if (!rc_service_value_set(svcname, "child_generation", counter) || !publish_child("pending")) {
+					close(child_pidfd); child_pidfd = -1;
+				}
+			}
+		}
+		if (child_pidfd < 0) {
+			saved = errno;
+			close(gate[1]); close(exec_pipe[0]);
+			do status = waitpid(pid, NULL, 0); while (status < 0 && errno == EINTR);
+			pid = -1;
+			errno = saved;
+		} else {
+			worker_gate = gate[1];
+			worker_exec = exec_pipe[0];
+		}
+	} else if (pid == 0) {
+		close(gate[1]); close(exec_pipe[0]);
+		if (control_lock >= 0)
+			close(control_lock);
+		memset(&action, 0, sizeof(action));
+		action.sa_handler = SIG_DFL;
+		sigemptyset(&action.sa_mask);
+		sigaction(SIGCHLD, &action, NULL);
+		sigaction(SIGTERM, &action, NULL);
+		sigaction(SIGALRM, &action, NULL);
