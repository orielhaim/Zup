+static bool random_identity(char value[33])
+{
+	unsigned char bytes[16];
+	size_t offset = 0;
+	ssize_t count;
+	int fd = open("/dev/urandom", O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+	int i;
+	if (fd < 0)
+		return false;
+	while (offset < sizeof(bytes)) {
+		count = read(fd, bytes + offset, sizeof(bytes) - offset);
+		if (count < 0 && errno == EINTR)
+			continue;
+		if (count <= 0) { close(fd); return false; }
+		offset += count;
+	}
+	close(fd);
+	for (i = 0; i < 16; ++i)
+		snprintf(value + i * 2, 3, "%02x", bytes[i]);
+	return true;
+}
+
+static uint64_t process_start_ticks(pid_t pid)
+{
+	char path[64], stat[4096], *field, *tail;
+	int fd, i;
+	ssize_t size;
+	uint64_t ticks;
+	snprintf(path, sizeof(path), "/proc/%ld/stat", (long)pid);
+	fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return 0;
+	size = read(fd, stat, sizeof(stat) - 1);
+	close(fd);
+	if (size <= 0)
+		return 0;
+	stat[size] = 0;
+	field = strrchr(stat, ')');
+	if (!field || field[1] != ' ')
+		return 0;
+	field += 2;
+	for (i = 0; i < 19; ++i) {
+		field = strchr(field, ' ');
+		if (!field)
+			return 0;
+		++field;
+	}
+	errno = 0;
+	ticks = strtoull(field, &tail, 10);
+	return errno || tail == field || *tail != ' ' ? 0 : ticks;
+}
+
+static bool publish_state(const char *path, const char *record)
+{
+	char *temporary;
+	int fd, saved;
+	size_t offset = 0, length = strlen(record);
+	ssize_t count;
+	bool written = true;
+
+	xasprintf(&temporary, "%s.new", path);
+	/* The controller lock permits one writer for this service. */
+	unlink(temporary);
+	fd = open(temporary, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600);
+	if (fd < 0) { free(temporary); return false; }
+	while (offset < length) {
+		count = write(fd, record + offset, length - offset);
+		if (count < 0 && errno == EINTR)
+			continue;
+		if (count <= 0) { written = false; break; }
+		offset += count;
+	}
+	if (close(fd) < 0)
+		written = false;
+	if (written && rename(temporary, path) < 0)
+		written = false;
+	saved = errno;
+	if (!written)
+		unlink(temporary);
+	free(temporary);
+	errno = saved;
+	return written;
+}
