+static void strict_respawn_wait(int64_t delay)
+{
+	int64_t deadline = tm_now() + delay;
+	int64_t remaining;
+
+	while (!exiting && (remaining = deadline - tm_now()) > 0)
+		strict_control(remaining > INT_MAX ? INT_MAX : (int)remaining);
+}
