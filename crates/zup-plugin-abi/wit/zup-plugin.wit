package zup:plugin@1.0.0;

interface planner {
  enum install-scope {
    user,
    machine,
  }

  record context {
    plugin-id: string,
    app-id: string,
    app-name: string,
    app-version: string,
    install-directory: string,
    install-scope: install-scope,
    target: string,
    selected-components: list<string>,
  }

  enum launcher-location {
    menu,
    desktop,
  }

  record generated-file {
    destination: string,
    contents: list<u8>,
  }

  record launcher {
    location: launcher-location,
    name: string,
    target: string,
    arguments: list<string>,
    working-directory: option<string>,
  }

  record path-entry {
    value: string,
  }

  enum service-start {
    automatic,
    manual,
    disabled,
  }

  enum initial-service-state {
    stopped,
    running,
  }

  enum changed-service-state {
    preserve,
    stopped,
  }

  record service-lifecycle {
    install: initial-service-state,
    change: changed-service-state,
    timeouts: option<service-timeouts>,
  }

  record systemd-timeouts {
    start-timeout-seconds: u32,
    stop-grace-seconds: u32,
    abort-timeout-seconds: u32,
    settle-seconds: u32,
  }
  record openrc-timeouts {
    start-timeout-seconds: u32,
    stop-grace-seconds: u32,
    kill-wait-seconds: u32,
    settle-seconds: u32,
  }
  record windows-timeouts {
    start-observation-seconds: u32,
    stop-observation-seconds: u32,
  }
  variant service-timeouts {
    systemd(systemd-timeouts),
    openrc(openrc-timeouts),
    windows(windows-timeouts),
  }

  enum windows-service-account {
    local-service,
    network-service,
    local-system,
  }

  record systemd-user {
    user: string,
    group: option<string>,
  }

  variant service-execution {
    windows(windows-service-account),
    systemd-dynamic-user,
    systemd-user(systemd-user),
    openrc-user(systemd-user),
  }

  enum systemd-restart-condition { on-failure, on-abnormal }
  record systemd-failure-policy {
    condition: systemd-restart-condition,
    delay-seconds: u32,
    start-limit-burst: u32,
    start-limit-interval-seconds: u32,
  }
  record windows-failure-policy {
    delay-seconds: u32,
    restart-attempts: u32,
    reset-seconds: u32,
  }
  record openrc-failure-policy {
    delay-seconds: u32,
    max-respawns: u32,
    respawn-period-seconds: u32,
  }
  variant service-failure-policy {
    none,
    systemd(systemd-failure-policy),
    windows(windows-failure-policy),
    openrc(openrc-failure-policy),
  }

  record service {
    failure: service-failure-policy,
    execution: service-execution,
    id: string,
    name: string,
    display-name: option<string>,
    binary: string,
    arguments: list<string>,
    start: service-start,
    lifecycle: service-lifecycle,
    readiness: service-readiness,
    requires-files: list<string>,
    requires-services: list<string>,
  }

  enum service-readiness {
    manager,
    notify,
  }

  record protocol {
    scheme: string,
    executable: string,
    args: list<string>,
  }

  record file-association {
    extension: string,
    id: string,
    description: option<string>,
    executable: string,
  }

  variant resource-item {
    generated-file(generated-file),
    launcher(launcher),
    path-entry(path-entry),
    service(service),
    protocol(protocol),
    file-association(file-association),
  }

  record installation-plan {
    resources: list<resource-item>,
  }

  record plugin-error {
    code: string,
    message: string,
  }

  plan: func(context: context) -> result<installation-plan, plugin-error>;
}

world plugin {
  export planner;
}
